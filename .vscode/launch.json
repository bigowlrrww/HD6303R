    {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Debug with GDB",
                "type": "cppdbg",
                "request": "launch",
                "windows": {"program": "${workspaceFolder}/HD6303_TEST.exe"},
                "linux": {
                    "program": "${workspaceFolder}/HD6303_TEST",
                    "miDebuggerPath": "/usr/bin/gdb",
                    "externalConsole": false
                },
                "args": [],
                "stopAtEntry": true,
                "cwd": "${workspaceFolder}",
                "environment": [],
                "externalConsole": false,
                "MIMode": "gdb",
                "miDebuggerPath": "gdb.exe", // Or the full path to gdb.exe if not in PATH
                "setupCommands": [
                    {
                        "description": "Enable pretty printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    }
                ]
            },
            {
                "name": "Debug Unit Tests",
                "type": "cppdbg",
                "request": "launch",
                "windows": {
                    "program": "${workspaceFolder}/UnitTests/HD6303_UNIT.exe",
                    "console": "integratedTerminal",
                    "miDebuggerPath": "gdb.exe"
                },
                "linux":{
                    "program": "${workspaceFolder}/UnitTests/HD6303_UNIT",
                    "miDebuggerPath": "/usr/bin/gdb"
                },
                "args": [],
                "stopAtEntry": false,
                "cwd": "${workspaceFolder}",
                "environment": [],
                "preLaunchTask": "Build Unit Tests",
                "externalConsole": false,
                "MIMode": "gdb",
            }
        ]
    }